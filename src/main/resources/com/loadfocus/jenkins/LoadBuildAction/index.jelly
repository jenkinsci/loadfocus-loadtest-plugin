<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">

<l:layout title="${it.displayName}">
    <st:include it="${it.owner}" page="sidepanel.jelly" from="${it.owner}" optional="true"/>
    <l:main-panel>
        <h1>${%LoadFocus.com Test Results}</h1>

        <j:choose>
          <j:when test="${it.reportUrl == null}">
            <p>${%Test not finished or invalid}</p>
          </j:when>
          <j:otherwise>
            <p>${%Test}: <strong>${it.testrunname}</strong>, ${%run} #${it.testrunid}</p>
            <j:if test="${it.verdict != null}">
              <p>${%Verdict}: <strong>${it.verdict}</strong></p>
            </j:if>
            <p><a href="${it.reportUrl}" target="_blank" rel="noopener noreferrer">${%Open the report on LoadFocus.com}</a></p>
          </j:otherwise>
        </j:choose>
    </l:main-panel>
</l:layout>
</j:jelly>
