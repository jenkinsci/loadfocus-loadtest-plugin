<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Test name}" field="testId">
        <f:textbox/>
    </f:entry>
    <f:entry title="${%API key credential ID}" field="apiKey">
        <f:textbox/>
    </f:entry>
    <f:entry title="${%Use LoadFocus verdict}" field="useVerdict">
        <f:checkbox/>
    </f:entry>
    <f:section title="${%LoadFocus thresholds, saved to the test on loadfocus.com}">
        <f:entry title="${%P95 response time, ms}" field="p95Ms"><f:number/></f:entry>
        <f:entry title="${%P99 response time, ms}" field="p99Ms"><f:number/></f:entry>
        <f:entry title="${%Error rate, %}" field="errorRatePct"><f:number step="any"/></f:entry>
        <f:entry title="${%Minimum throughput, req/s}" field="minRps"><f:number step="any"/></f:entry>
    </f:section>
    <f:section title="${%Per-request thresholds}">
        <f:entry title="${%Error % UNSTABLE}" field="errorUnstableThreshold"><f:number/></f:entry>
        <f:entry title="${%Error % FAILED}" field="errorFailedThreshold"><f:number/></f:entry>
        <f:entry title="${%Average response time UNSTABLE, ms}" field="responseTimeUnstableThreshold"><f:number/></f:entry>
        <f:entry title="${%Average response time FAILED, ms}" field="responseTimeFailedThreshold"><f:number/></f:entry>
    </f:section>
    <f:advanced>
        <f:entry title="${%Tag the run with this build}" field="tagRun"><f:checkbox default="true"/></f:entry>
        <f:entry title="${%Run tag}" field="releaseTag"><f:textbox/></f:entry>
        <f:entry title="${%Timeout, minutes}" field="timeoutMinutes"><f:number default="120" min="1"/></f:entry>
        <f:entry title="${%Create public share link}" field="shareReport"><f:checkbox/></f:entry>
    </f:advanced>
</j:jelly>
