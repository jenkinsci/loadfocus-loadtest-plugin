<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define"
         xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">

    <f:entry title="">
      <a href="https://loadfocus.com" target="_blank">
        <img src="${rootURL}/plugin/loadfocus-loadtest/images/logo.png" alt="logo" height="50px"/>
      </a>
    </f:entry>
    
    <f:entry title="${%API Key}" field="apiKey">
      <f:select style="width:32em;"/>
    </f:entry>
    
    <f:entry title="${%Test Name}:" field="testId">
      <f:select>
      </f:select>
    </f:entry>

     <f:entry title="${%Error Percentage threshold}:"
             description="${%Checked per request. The build is marked UNSTABLE or FAILED when a request's error percentage is greater than the threshold. Leave empty to skip.}">
      <table width="500px">
        <tbody>
          <tr>
            <td style="vertical-align:middle">
                <f:entry title="UNSTABLE (%)" field="errorUnstableThreshold">
                    <f:textbox />
                </f:entry>
            </td>
            <td style="vertical-align:middle">
                <f:entry title="FAILED (%)" field="errorFailedThreshold">
                    <f:textbox />
                </f:entry>
            </td>
          </tr>
        </tbody>
      </table>
    </f:entry>

    <f:entry title="" field="">
    </f:entry>

    <f:entry title="${%Response Time threshold}:"
             description="${%Checked per request. The build is marked UNSTABLE or FAILED when a request's average response time is greater than the threshold. Leave empty to skip.}">
    <table width="500px">
      <tbody>
        <tr>
            <td style="vertical-align:middle">
                <f:entry title="UNSTABLE (ms)" field="responseTimeUnstableThreshold">
                    <f:textbox />
                </f:entry>
            </td>
            <td style="vertical-align:middle; color: #0F0F0F">
                <f:entry title="FAILED (ms)" field="responseTimeFailedThreshold">
                    <f:textbox />
                </f:entry>
            </td>
        </tr>
      </tbody>
    </table>
    </f:entry>

    <f:entry title="${%Use LoadFocus verdict}" field="useVerdict">
      <f:checkbox/>
    </f:entry>

    <f:section title="${%LoadFocus thresholds, saved to the test on loadfocus.com}">
      <f:entry title="${%P95 response time, ms}" field="p95Ms"><f:number/></f:entry>
      <f:entry title="${%P99 response time, ms}" field="p99Ms"><f:number/></f:entry>
      <f:entry title="${%Error rate, %}" field="errorRatePct"><f:number step="any"/></f:entry>
      <f:entry title="${%Minimum throughput, req/s}" field="minRps"><f:number step="any"/></f:entry>
    </f:section>

    <f:advanced>
      <f:entry title="${%Tag the run with this build}" field="tagRun">
        <f:checkbox default="true"/>
      </f:entry>
      <f:entry title="${%Run tag}" field="releaseTag">
        <f:textbox/>
      </f:entry>
      <f:entry title="${%Timeout, minutes}" field="timeoutMinutes">
        <f:number default="120" min="1"/>
      </f:entry>
      <f:entry title="${%Create public share link}" field="shareReport">
        <f:checkbox/>
      </f:entry>
    </f:advanced>
</j:jelly>
